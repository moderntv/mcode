{
  "name": "mcode/mcode",
  "description": "PHP quality assurance for ModernTV projects.",
  "keywords": [
    "php",
    "qa"
  ],
  "type": "library",
  "license": "MIT",
  "homepage": "https://github.com/moderntv/mstyle",
  "authors": [
    {
      "name": "Milan Felix Šulc",
      "homepage": "https://f3l1x.io"
    }
  ],
  "require": {
    "php": ">=8.4",
    "mockery/mockery": "^1.6.12",
    "php-parallel-lint/php-parallel-lint": "^1.4.0",
    "phpstan/phpstan": "^2.2.8",
    "phpstan/phpstan-deprecation-rules": "^2.0.3",
    "phpstan/phpstan-nette": "^2.0.9",
    "phpstan/phpstan-strict-rules": "^2.0.9",
    "phpunit/phpunit": "^12.4.2 || ^13.3.0",
    "slevomat/coding-standard": "^8.31.1",
    "squizlabs/php_codesniffer": "^4.0.4"
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "extra": {
    "branch-alias": {
      "dev-master": "0.5.x-dev"
    }
  }
}
